{
  "appId": "com.abdulazeez.critterclash",
  "appName": "Critter Clash",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0d0b1f"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0d0b1f"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0d0b1f",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d0b1f",
      "overlaysWebView": false
    }
  }
}
