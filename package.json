{
  "name": "critter-clash",
  "version": "1.1.0",
  "description": "Critter Clash Idle - an idle/clicker monster battler for Android & iOS",
  "private": true,
  "scripts": {
    "serve": "npx --yes serve www -l 5173",
    "sync": "npx cap sync",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "icons": "node tools/make-icons.js",
    "test": "node tools/test-bignum.js && node tools/test-game.js && node tools/test-arena.js && node tools/test-ui-new.js",
    "test:endless": "node tools/test-endless.js",
    "bundle": "node tools/bundle.js",
    "shots": "node tools/shots.js",
    "release:check": "node tools/release-check.js",
    "android:stamp": "node tools/stamp-version.js",
    "test:all": "npm test && npm run test:endless"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor-community/admob": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "playwright": "^1.49.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azoz20032021/critter-clash.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/azoz20032021/critter-clash",
  "bugs": {
    "url": "https://github.com/azoz20032021/critter-clash/issues"
  },
  "author": "azoz20032021"
}
